{
  "Ftp": {
    "Host": "localhost",
    "Port": 2121,
    "User": "",
    "Password": "",
    "RootDir": "/incoming"
  },
  "Monitor": {
    "DbFile": "monitor.db",
    "MinIntervalSeconds": 15,
    "MaxIntervalSeconds": 300,
    "IntervalStepSeconds": 15,
    "MaxDepth": 10,
    "WaitForStableSize": true
  },
  "Rules": [
    { "Name": "app-logs", "Pattern": "^APP_\\d{4}_\\d{2}_\\d{2}_\\d{6}\\.log$", "IsRegex": true },
    { "Name": "text", "Pattern": "*.txt", "IsRegex": false },
    { "Name": "reports", "Pattern": "report_*.csv", "IsRegex": false }
  ]
}
